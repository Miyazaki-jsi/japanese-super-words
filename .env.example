# Public Gumroad checkout URLs (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_TRIP_PACK_GUMROAD_URL=
NEXT_PUBLIC_JAPAN_PRO_GUMROAD_URL=

# Gumroad product permalinks or IDs (comma-separated) for license verification
GUMROAD_TRIP_PRODUCT_IDS=gxmbiol
GUMROAD_PRO_PRODUCT_IDS=cspei

# Gumroad access token — for webhook auto-setup + purchase backfill sync
# https://app.gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=

# Gumroad seller ID — required for webhook seller verification + monetization status
# Find in Gumroad Settings → Advanced, or run: bash scripts/setup-gumroad.sh
GUMROAD_SELLER_ID=

# Shared unlock codes (fallback when license key verify is unavailable)
TRIP_PACK_UNLOCK_CODES=
JAPAN_PRO_UNLOCK_CODES=

# --- Admin dashboard (Supabase analytics + /admin) ---
# 1. Create Supabase project → run supabase/schema.sql in SQL Editor
# 2. Project Settings → API → copy URL + service_role key (not anon)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login at /admin/login (not linked from the public app)
# Run: npm run setup:admin  (generates ADMIN_SESSION_SECRET, prints Vercel steps)
# Or one-shot: npm run provision:admin  (needs SUPABASE_ACCESS_TOKEN + VERCEL_TOKEN)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- X daily auto-post (/admin/social) ---
# Public app URL used in tweet links
NEXT_PUBLIC_APP_URL=https://japanese-super-words.vercel.app

# Vercel Cron auth (Dashboard → Settings → Environment Variables)
# Generate: openssl rand -hex 32
CRON_SECRET=

# X API (optional until ready — without these, drafts are created for manual copy/paste)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Set true only when X API keys are ready and you want automatic posting
X_AUTO_POST=false
