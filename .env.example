# Public Gumroad checkout URLs (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_TRIP_PACK_GUMROAD_URL=
NEXT_PUBLIC_JAPAN_PRO_GUMROAD_URL=

# Gumroad product permalinks or IDs (comma-separated) for license verification
GUMROAD_TRIP_PRODUCT_IDS=gxmbiol
GUMROAD_PRO_PRODUCT_IDS=cspei

# Gumroad seller ID — required for webhook seller verification + monetization status
# Find in Gumroad Settings → Advanced, or run: bash scripts/setup-gumroad.sh
GUMROAD_SELLER_ID=

# Shared unlock codes (fallback when license key verify is unavailable)
TRIP_PACK_UNLOCK_CODES=
JAPAN_PRO_UNLOCK_CODES=

# Admin dashboard (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
